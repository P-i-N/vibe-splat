# Compiles GLSL compute/graphics shaders to SPIR-V with glslang (built by vcpkg
# as a host tool) and embeds the result into a static library, so the program
# never loads shader files at runtime. All modules of a library are stored as
# one xz stream (355 KB of SPIR-V packs into about 64 KB) and unpacked on first
# use.
#
#   splat_add_shader_library(<target> SOURCES a.comp b.comp ...)
#
# Generates <target>/shaders.hpp exposing:
#   namespace splat::shaders { std::span<const uint32_t> <name>(); }
# where <name> is the file name with '.' replaced by '_' (e.g. selftest_comp).

# glslang is a host dependency: vcpkg installs it for the host triplet, which
# differs from the target triplet on Windows (x64-windows vs x64-windows-static).
set(_glslang_hints "")
if(DEFINED VCPKG_INSTALLED_DIR)
  if(VCPKG_HOST_TRIPLET)
    list(APPEND _glslang_hints "${VCPKG_INSTALLED_DIR}/${VCPKG_HOST_TRIPLET}/tools/glslang")
  endif()
  file(GLOB _glslang_tool_dirs LIST_DIRECTORIES true "${VCPKG_INSTALLED_DIR}/*/tools/glslang")
  list(APPEND _glslang_hints ${_glslang_tool_dirs})
endif()

find_program(GLSLANG_VALIDATOR
  NAMES glslang glslangValidator
  HINTS ${_glslang_hints}
  REQUIRED)
message(STATUS "Shader compiler: ${GLSLANG_VALIDATOR}")

set(SPLAT_SHADER_PACK_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/PackSpirv.cmake")
set(SPLAT_SHADER_PACK_TEMPLATE "${CMAKE_CURRENT_LIST_DIR}/SpirvPack.cpp.in")

function(splat_add_shader_library target)
  cmake_parse_arguments(ARG "" "" "SOURCES" ${ARGN})
  set(gen_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}")
  set(header "${gen_dir}/shaders.hpp")
  file(MAKE_DIRECTORY "${gen_dir}")

  # Shared include files: any change recompiles every shader.
  file(GLOB includes CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.glsl")

  set(spvs "")
  set(names "")
  set(decls "")
  foreach(src IN LISTS ARG_SOURCES)
    get_filename_component(abs "${src}" ABSOLUTE)
    get_filename_component(fname "${src}" NAME)
    string(REPLACE "." "_" sym "${fname}")
    set(spv "${gen_dir}/${fname}.spv")

    add_custom_command(
      OUTPUT "${spv}"
      COMMAND "${GLSLANG_VALIDATOR}" -V --target-env vulkan1.3 -g0
              -I"${CMAKE_CURRENT_SOURCE_DIR}" -o "${spv}" "${abs}"
      DEPENDS "${abs}" ${includes}
      COMMENT "Compiling shader ${fname}"
      VERBATIM)

    list(APPEND spvs "${spv}")
    list(APPEND names "${fname}")
    string(APPEND decls "std::span<const std::uint32_t> ${sym}();\n")
  endforeach()

  set(cpp "${gen_dir}/shaders.cpp")
  list(JOIN names "," names_arg)
  add_custom_command(
    OUTPUT "${cpp}"
    COMMAND "${CMAKE_COMMAND}" -DGEN_DIR=${gen_dir} -DNAMES=${names_arg} -DTARGET=${target}
            -DTEMPLATE=${SPLAT_SHADER_PACK_TEMPLATE} -DOUTPUT=${cpp} -P "${SPLAT_SHADER_PACK_SCRIPT}"
    DEPENDS ${spvs} "${SPLAT_SHADER_PACK_SCRIPT}" "${SPLAT_SHADER_PACK_TEMPLATE}"
    COMMENT "Packing ${target}"
    VERBATIM)

  file(CONFIGURE OUTPUT "${header}" CONTENT
"// Generated by cmake/Shaders.cmake. Do not edit.
#pragma once
#include <cstdint>
#include <span>

namespace splat::shaders {
// SPIR-V words of each shader. The first call unpacks all of them.
${decls}} // namespace splat::shaders
")

  add_library(${target} STATIC "${cpp}" "${header}")
  target_include_directories(${target} PUBLIC "${CMAKE_CURRENT_BINARY_DIR}")
  target_link_libraries(${target} PRIVATE liblzma::liblzma)
endfunction()
