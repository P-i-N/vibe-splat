#version 460
// Loss, part 1: the horizontal half of SSIM's Gaussian window. For each pixel,
// five weighted means across its row: x, y, x^2, y^2, xy. Splitting the 11x11
// window into two passes of 11 samples is what makes SSIM cheap.
layout(local_size_x = 16) in;

layout(std430, binding = 0) readonly buffer Image { vec4 image[]; };
layout(std430, binding = 1) readonly buffer Target { uint target[]; };
layout(std430, binding = 2) writeonly buffer Moments { vec4 moments[]; };

layout(push_constant) uniform Push { uint width; uint height; } pc;

const float WEIGHTS[11] = float[](0.00102838, 0.00759876, 0.03600077, 0.10936069, 0.21300554, 0.26601172,
                                  0.21300554, 0.10936069, 0.03600077, 0.00759876, 0.00102838);

void main() {
  const uint row = gl_GlobalInvocationID.x;
  if (row >= pc.height) {
    return;
  }
  for (uint px = 0u; px < pc.width; ++px) {
    vec3 mx = vec3(0.0), my = vec3(0.0), xx = vec3(0.0), yy = vec3(0.0), xy = vec3(0.0);
    float norm = 0.0;
    const int x0 = max(int(px) - 5, 0), x1 = min(int(px) + 5, int(pc.width) - 1);
    for (int u = x0; u <= x1; ++u) {
      const float w = WEIGHTS[u - int(px) + 5];
      const uint at = row * pc.width + uint(u);
      const vec3 a = image[at].rgb;
      const vec3 b = unpackUnorm4x8(target[at]).rgb;
      mx += w * a;
      my += w * b;
      xx += w * a * a;
      yy += w * b * b;
      xy += w * a * b;
      norm += w;
    }
    const uint out0 = (row * pc.width + px) * 5u;
    moments[out0] = vec4(mx / norm, 0.0);
    moments[out0 + 1u] = vec4(my / norm, 0.0);
    moments[out0 + 2u] = vec4(xx / norm, 0.0);
    moments[out0 + 3u] = vec4(yy / norm, 0.0);
    moments[out0 + 4u] = vec4(xy / norm, 0.0);
  }
}
