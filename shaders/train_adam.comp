#version 460
// One Adam step (Kingma and Ba 2015) over a flat array of parameters.
// Selective when asked, as in gsplat and Taming 3DGS: a parameter without a
// gradient, which means its Gaussian was out of view, keeps its value and
// moments rather than drifting on momentum from other views. Most Gaussians
// are out of any one view, so this also skips most of the memory traffic.
//
// Both moments are kept in bfloat16. With beta1 = 0.9 a step moves the first
// by a tenth, far more than its rounding. A step moves the second by a
// thousandth, under half its rounding, so rounded to nearest it would stall:
// it is rounded at random instead, which keeps its average exact. One thread
// per word of the moments, so two parameters.
#extension GL_GOOGLE_include_directive : require
#include "bf16.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Parameters { float parameters[]; };
layout(std430, binding = 1) readonly buffer Gradients { float gradients[]; };
layout(std430, binding = 2) buffer FirstMoment { uint m[]; };
layout(std430, binding = 3) buffer SecondMoment { uint v[]; };

layout(push_constant) uniform Push {
  uint count;
  float learningRate;
  float beta1;
  float beta2;
  float epsilon;
  float correction1; // 1 - beta1^t
  float correction2; // 1 - beta2^t
  uint dcStride;     // SH only: floats per Gaussian, whose first 3 use the full rate
  float restScale;   // The other coefficients' rate, relative to that
  uint selective;    // Leave parameters without a gradient alone
  uint seed;         // Of this step's rounding
} pc;

void main() {
  const uint word = gl_GlobalInvocationID.x;
  if (2u * word >= pc.count) {
    return;
  }
  uint first = m[word], second = v[word];
  bool changed = false;
  for (uint slot = 0u; slot < 2u; ++slot) {
    const uint i = 2u * word + slot;
    if (i >= pc.count) {
      break;
    }
    const float g = gradients[i];
    if (pc.selective != 0u && g == 0.0) {
      continue;
    }
    const float mi = pc.beta1 * bf16_load(first, slot) + (1.0 - pc.beta1) * g;
    first = bf16_store(first, slot, bf16_round(mi));
    changed = true;
    const float vi = pc.beta2 * bf16_load(second, slot) + (1.0 - pc.beta2) * g * g;
    second = bf16_store(second, slot, bf16_stochastic(vi, i, pc.seed));
    const float rate = pc.dcStride > 0u && i % pc.dcStride >= 3u ? pc.learningRate * pc.restScale : pc.learningRate;
    parameters[i] -= rate * (mi / pc.correction1) / (sqrt(vi / pc.correction2) + pc.epsilon);
  }
  if (changed) {
    m[word] = first;
    v[word] = second;
  }
}
