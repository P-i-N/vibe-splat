#version 460
// Loss, part 3: takes the adjoint from the exposed image back to the rendered
// one, in place, and sums the derivative of the loss with respect to the
// exposure transform over each workgroup's pixels:
//   rgb' = A rgb + b    dL/drgb = A^T dL/drgb'    dL/dA = dL/drgb' rgb^T    dL/db = dL/drgb'
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_GOOGLE_include_directive : require
#include "workgroup_sum.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Image { vec4 image[]; };
layout(std430, binding = 1) buffer Adjoint { vec4 adjoint[]; };
layout(std430, binding = 2) writeonly buffer GroupTotals { float groupTotals[]; }; // 12 per workgroup, as transform

layout(push_constant) uniform Push {
  mat3x4 transform;
  uint pixels;
} pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  vec3 g = vec3(0.0);
  vec4 rgb1 = vec4(0.0);
  if (i < pc.pixels) {
    g = adjoint[i].rgb;
    rgb1 = vec4(image[i].rgb, 1.0);
    const vec3 back = g.r * pc.transform[0].rgb + g.g * pc.transform[1].rgb + g.b * pc.transform[2].rgb;
    adjoint[i].rgb = back;
  }
  for (uint row = 0u; row < 3u; ++row) {
    for (uint column = 0u; column < 4u; ++column) {
      const float total = workgroup_sum(g[row] * rgb1[column]);
      if (gl_LocalInvocationIndex == 0u) {
        groupTotals[gl_WorkGroupID.x * 12u + row * 4u + column] = total;
      }
    }
  }
}
