#version 460
// Loss, part 3: the horizontal half of the window applied to the fields. The
// window is symmetric, so the derivative uses the same weights.
layout(local_size_x = 16) in;

layout(std430, binding = 0) readonly buffer Fields { vec4 fields[]; };
layout(std430, binding = 1) writeonly buffer Moments { vec4 moments[]; };

layout(push_constant) uniform Push { uint width; uint height; } pc;

const float WEIGHTS[11] = float[](0.00102838, 0.00759876, 0.03600077, 0.10936069, 0.21300554, 0.26601172,
                                  0.21300554, 0.10936069, 0.03600077, 0.00759876, 0.00102838);

void main() {
  const uint row = gl_GlobalInvocationID.x;
  if (row >= pc.height) {
    return;
  }
  for (uint px = 0u; px < pc.width; ++px) {
    vec3 p = vec3(0.0), q = vec3(0.0), r = vec3(0.0);
    const int x0 = max(int(px) - 5, 0), x1 = min(int(px) + 5, int(pc.width) - 1);
    for (int u = x0; u <= x1; ++u) {
      const float w = WEIGHTS[u - int(px) + 5];
      const uint at = (row * pc.width + uint(u)) * 3u;
      p += w * fields[at].rgb;
      q += w * fields[at + 1u].rgb;
      r += w * fields[at + 2u].rgb;
    }
    const uint out0 = (row * pc.width + px) * 5u;
    moments[out0] = vec4(p, 0.0);
    moments[out0 + 1u] = vec4(q, 0.0);
    moments[out0 + 2u] = vec4(r, 0.0);
  }
}
