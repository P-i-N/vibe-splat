#version 460
// Device self-test: out[i] = a[i] * scale + b[i], plus a subgroup sum per
// workgroup to confirm subgroup arithmetic works on this driver.
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer Out { float result[]; };
layout(std430, binding = 3) buffer Sums { uint subgroupSums[]; };

layout(push_constant) uniform Push {
  uint count;
  float scale;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  uint one = i < pc.count ? 1u : 0u;
  uint total = subgroupAdd(one);
  if (subgroupElect()) {
    atomicAdd(subgroupSums[0], total);
  }
  if (i < pc.count) {
    result[i] = a[i] * pc.scale + b[i];
  }
}
