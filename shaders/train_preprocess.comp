#version 460
// Forward pass, step 1: from raw trainable parameters to screen-space splats,
// a depth sort key, and how many tiles each splat covers. position.w of the
// camera holds the near plane.
#extension GL_GOOGLE_include_directive : require
#include "splat_types.glsl"
#include "train_types.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Positions { float positions[]; };
layout(std430, binding = 1) readonly buffer Scales { float scales[]; };
layout(std430, binding = 2) readonly buffer Rotations { float rotations[]; };
layout(std430, binding = 3) readonly buffer Opacities { float opacities[]; };
layout(std430, binding = 4) readonly buffer SH { float sh[]; };
layout(std430, binding = 5) readonly buffer Camera { CameraParams cam; };
layout(std430, binding = 6) writeonly buffer Splats { TrainSplat splats[]; };
layout(std430, binding = 7) writeonly buffer Keys { uint keys[]; };
layout(std430, binding = 8) writeonly buffer Values { uint values[]; };

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= cam.counts.x) {
    return;
  }
  keys[i] = INVISIBLE;
  values[i] = i;

  const vec3 p = vec3(positions[i * 3u], positions[i * 3u + 1u], positions[i * 3u + 2u]);
  const vec3 t = (cam.view * vec4(p, 1.0)).xyz;
  if (t.z < cam.position.w) {
    return;
  }
  const float opacity = 1.0 / (1.0 + exp(-opacities[i]));
  if (opacity < 1.0 / 255.0) {
    return;
  }

  vec4 q = vec4(rotations[i * 4u], rotations[i * 4u + 1u], rotations[i * 4u + 2u], rotations[i * 4u + 3u]);
  const float len = length(q);
  q = len > 0.0 ? q / len : vec4(1.0, 0.0, 0.0, 0.0);
  const vec3 s = exp(vec3(scales[i * 3u], scales[i * 3u + 1u], scales[i * 3u + 2u]));
  const mat3 M = train_quat_to_mat(q) * mat3(s.x, 0.0, 0.0, 0.0, s.y, 0.0, 0.0, 0.0, s.z);
  const mat3 sigma = M * transpose(M);

  const float fx = cam.intrinsics.x, fy = cam.intrinsics.y;
  const float limX = 1.3 * cam.viewport.z, limY = 1.3 * cam.viewport.w;
  const float tx = clamp(t.x / t.z, -limX, limX) * t.z;
  const float ty = clamp(t.y / t.z, -limY, limY) * t.z;
  const mat3 J = mat3(fx / t.z, 0.0, 0.0,
                      0.0, fy / t.z, 0.0,
                      -fx * tx / (t.z * t.z), -fy * ty / (t.z * t.z), 0.0);
  const mat3 T = J * mat3(cam.view);
  const mat3 cov = T * sigma * transpose(T);

  const float a = cov[0][0] + 0.3;
  const float b = cov[0][1];
  const float c = cov[1][1] + 0.3;
  const float det = a * c - b * b;
  if (det <= 0.0) {
    return;
  }
  const float mid = 0.5 * (a + c);
  const float lambda = mid + sqrt(max(0.1, mid * mid - det));
  const float radius = ceil(3.0 * sqrt(lambda));

  const vec2 center = vec2(fx * t.x / t.z + cam.intrinsics.z, fy * t.y / t.z + cam.intrinsics.w);
  if (center.x + radius < 0.0 || center.y + radius < 0.0 || center.x - radius > cam.viewport.x ||
      center.y - radius > cam.viewport.y) {
    return;
  }

  const uint degree = cam.counts.y;
  float basis[16];
  sh_basis(normalize(p - cam.position.xyz), degree, basis);
  const uint coefficients = cam.counts.z / 3u;
  const uint base = i * cam.counts.z;
  vec3 color = vec3(0.5);
  for (uint k = 0u; k < coefficients; ++k) {
    color += basis[k] * vec3(sh[base + k * 3u], sh[base + k * 3u + 1u], sh[base + k * 3u + 2u]);
  }

  const float gridW = ceil(cam.viewport.x / float(TILE_SIZE)), gridH = ceil(cam.viewport.y / float(TILE_SIZE));
  const float size = float(TILE_SIZE);
  splats[i].centerRadius = vec4(center, radius, t.z);
  splats[i].conicOpacity = vec4(vec3(c, -b, a) / det, opacity);
  splats[i].color = vec4(max(color, vec3(0.0)), 1.0);
  splats[i].tiles = uvec4(uint(max(0.0, floor((center.x - radius) / size))),
                          uint(max(0.0, floor((center.y - radius) / size))),
                          uint(clamp(floor((center.x + radius) / size), 0.0, gridW - 1.0)),
                          uint(clamp(floor((center.y + radius) / size), 0.0, gridH - 1.0)));
  keys[i] = 0xFFFFFFFFu - floatBitsToUint(t.z);
}
