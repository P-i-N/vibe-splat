#version 460
// 3DGS-MCMC's exploration: after each optimiser step, every Gaussian's position
// moves by scaler * sigma(1 - opacity) * Sigma * n, with n three standard
// normals, Sigma its covariance and sigma a steep logistic, so that only the
// nearly transparent wander. The randomness is a hash of the Gaussian's index
// and the iteration, so that a run repeats.
#extension GL_GOOGLE_include_directive : require
#include "splat_types.glsl"
#include "train_types.glsl"
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions { float positions[]; };
layout(std430, binding = 1) readonly buffer Scales { float scales[]; };
layout(std430, binding = 2) readonly buffer Rotations { float rotations[]; };
layout(std430, binding = 3) readonly buffer Opacities { float opacities[]; };

layout(push_constant) uniform Push {
  uint count;
  float scaler; // noise_lr times the position learning rate
  uint iteration;
} pc;

// PCG's output permutation over a 32-bit state, as a hash.
uint pcg_hash(uint v) {
  const uint state = v * 747796405u + 2891336453u;
  const uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

// Uniform in (0, 1], never 0, so that the logarithm below is finite.
float uniform_of(uint i, uint k) {
  return (float(pcg_hash(pcg_hash(i * 4u + k) ^ (pc.iteration * 0x9E3779B9u))) + 1.0) / 4294967297.0;
}

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) {
    return;
  }
  const float opacity = 1.0 / (1.0 + exp(-opacities[i]));
  const float gate = 1.0 / (1.0 + exp(-100.0 * ((1.0 - opacity) - 0.995)));
  if (gate < 1e-6) {
    return;
  }
  // Box-Muller: two uniforms give two normals; three are needed.
  const float u0 = uniform_of(i, 0u), u1 = uniform_of(i, 1u), u2 = uniform_of(i, 2u), u3 = uniform_of(i, 3u);
  const float r0 = sqrt(-2.0 * log(u0)), r1 = sqrt(-2.0 * log(u2));
  const vec3 n = vec3(r0 * cos(6.283185307 * u1), r0 * sin(6.283185307 * u1), r1 * cos(6.283185307 * u3));

  vec4 quat = vec4(rotations[i * 4u], rotations[i * 4u + 1u], rotations[i * 4u + 2u], rotations[i * 4u + 3u]);
  const float quatLength = length(quat);
  quat = quatLength > 0.0 ? quat / quatLength : vec4(1.0, 0.0, 0.0, 0.0);
  const mat3 R = train_quat_to_mat(quat);
  const vec3 s2 = exp(2.0 * vec3(scales[i * 3u], scales[i * 3u + 1u], scales[i * 3u + 2u]));
  const mat3 sigma = R * mat3(s2.x, 0.0, 0.0, 0.0, s2.y, 0.0, 0.0, 0.0, s2.z) * transpose(R);
  const vec3 move = pc.scaler * gate * (sigma * n);
  if (any(isnan(move)) || any(isinf(move))) {
    return;
  }
  positions[i * 3u] += move.x;
  positions[i * 3u + 1u] += move.y;
  positions[i * 3u + 2u] += move.z;
}
