#version 460
// The backward pass for GPUs with float atomics.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_atomic_float : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_shuffle : require

layout(std430, binding = 6) buffer Gradients { float gradients[]; };
layout(std430, binding = 7) readonly buffer Edge { float edge[]; }; // From train_loss.comp, when scoring

void add_gradient(uint at, float value) { atomicAdd(gradients[at], value); }

#include "train_backward.glsl"
