#version 460
// Backward pass, step 2: the chain rule from the screen-space sums of the
// previous step down to the raw parameters, and what becomes of the result
// (pc.mode): only the densification statistics, the gradients stored, or the
// optimiser's step taken at once, which is how training runs, so that no
// gradient is ever stored. The maths is mirrored and checked against finite
// differences in src/train/reference.cpp. SH steps in a pass of its own,
// train_sh_step.comp, one thread per word: a thread here stepping all of a
// Gaussian's would touch memory at a stride, several times slower.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_GOOGLE_include_directive : require
#include "bf16.glsl"
#include "splat_types.glsl"
#include "train_types.glsl"
#include "workgroup_sum.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions { float positions[]; };
layout(std430, binding = 1) buffer Scales { float scales[]; };
layout(std430, binding = 2) buffer Rotations { float rotations[]; };
layout(std430, binding = 3) buffer Opacities { float opacities[]; };
layout(std430, binding = 4) buffer SH { uint sh[]; }; // See train_sh.glsl
layout(std430, binding = 5) readonly buffer Camera { CameraParams cam; };
// The backward pass's sums, RAW_PER_SPLAT per splat. In MODE_STEP and
// MODE_CURVATURE they are replaced, for the SH pass, by what it needs: see
// the end of chain().
layout(std430, binding = 6) buffer Raw { float raw[]; };
layout(std430, binding = 7) readonly buffer Splats { TrainSplat splats[]; };
layout(std430, binding = 8) buffer DensifyStats { DensifyStat densifyStats[]; };
layout(std430, binding = 9) readonly buffer Filter3d { float filter3d[]; }; // As in train_preprocess.comp
// The optimiser's state, one word per parameter: two bfloat16, the first
// moment in the low half and in the high half the second moment or, once
// steps are second order, the curvature.
layout(std430, binding = 10) buffer PositionState { uint positionState[]; };
layout(std430, binding = 11) buffer ScaleState { uint scaleState[]; };
layout(std430, binding = 12) buffer RotationState { uint rotationState[]; };
layout(std430, binding = 13) buffer OpacityState { uint opacityState[]; };
layout(std430, binding = 14) buffer SHState { uint shState[]; };
// MODE_GRADIENTS only.
layout(std430, binding = 15) writeonly buffer GradPositions { float gradPositions[]; };
layout(std430, binding = 16) writeonly buffer GradScales { float gradScales[]; };
layout(std430, binding = 17) writeonly buffer GradRotations { float gradRotations[]; };
layout(std430, binding = 18) writeonly buffer GradOpacities { float gradOpacities[]; };
layout(std430, binding = 19) writeonly buffer GradSH { float gradSh[]; };
// FLAG_POSE only: 6 per workgroup, w and v, as main() describes.
layout(std430, binding = 20) writeonly buffer PoseTotals { float poseTotals[]; };

#include "train_sh.glsl"
#include "train_step.glsl"

// What becomes of gradient g of parameter `at` of a group, by pc.mode. A
// parameter without a gradient was out of view: second-order steps and the
// curvature leave it alone, and Adam too when selective (gsplat, Taming 3DGS),
// rather than letting it drift on momentum from other views.
#define EMITTER(name, value, state, gradient, group)                                                    \
  void name(uint at, float g, float rate, float radius) {                                              \
    if (pc.mode == MODE_GRADIENTS) {                                                                   \
      gradient[at] = g;                                                                                \
    } else if (g != 0.0 || (pc.mode == MODE_STEP && (pc.flags & FLAG_SELECTIVE) == 0u && radius < 0.0)) { \
      uint s = state[at];                                                                              \
      if (pc.mode == MODE_CURVATURE) {                                                                 \
        state[at] = with_curvature(s, g, at * 5u + group);                                             \
      } else {                                                                                         \
        float v = value[at];                                                                           \
        step_parameter(v, s, g, rate, radius, at * 5u + group);                                        \
        value[at] = v;                                                                                 \
        state[at] = s;                                                                                 \
      }                                                                                                \
    }                                                                                                  \
  }
EMITTER(emit_position, positions, positionState, gradPositions, 0u)
EMITTER(emit_scale, scales, scaleState, gradScales, 1u)
EMITTER(emit_rotation, rotations, rotationState, gradRotations, 2u)
EMITTER(emit_opacity, opacities, opacityState, gradOpacities, 3u)

// The SH pass (train_sh_step.comp) takes the steps of SH; this stores its
// gradients, of element j of Gaussian i's.
void store_sh(uint i, uint j, float g) {
  if (pc.mode == MODE_GRADIENTS) {
    gradSh[i * pc.shFloats + j] = g;
  }
}

// tr(G A X J^T) for 2x2 symmetric G, with A and J 2x3 and X 3x3.
float trace_term(mat2 G, mat3x2 A, mat3 X, mat3x2 J) {
  const mat2 product = G * (A * X * transpose(J));
  return product[0][0] + product[1][1];
}

// What densification decides on. Only this invocation touches this element.
// Per half the image rather than per pixel, so that one threshold suits any resolution.
void add_statistics(uint i) {
  const uint at = i * RAW_PER_SPLAT;
  densifyStats[i].main.x += length(vec2(raw[at + 1u], raw[at + 2u]) * 0.5 * cam.viewport.xy);
  densifyStats[i].main.y += 1.0;
  densifyStats[i].main.z = max(densifyStats[i].main.z, splats[i].colorRadius.w);
  densifyStats[i].main.w += raw[at + 9u] * 3.0 * cam.viewport.x * cam.viewport.y; // In pixels
  densifyStats[i].more.x += length(vec2(raw[at + 10u], raw[at + 11u]) * 0.5 * cam.viewport.xy);
}

// Gaussian i's chain rule, and what becomes of it. Returns how the loss
// changes with the camera through this Gaussian's position, for FLAG_POSE.
void chain(uint i, out vec3 poseW, out vec3 poseV) {
  poseW = vec3(0.0);
  poseV = vec3(0.0);
  // Nothing reached this splat. The sums were cleared, so skip the maths,
  // which would not even be defined for a splat behind the camera.
  bool touched = false;
  for (uint k = 0u; k < RAW_PER_SPLAT; ++k) {
    touched = touched || raw[i * RAW_PER_SPLAT + k] != 0.0;
  }
  // Whether gradients of zero do anything: stored, or as Adam's step when not selective.
  const bool zeros = pc.mode == MODE_GRADIENTS || (pc.mode == MODE_STEP && (pc.flags & FLAG_SELECTIVE) == 0u);
  const bool penalties = pc.opacityReg > 0.0 || pc.scaleReg > 0.0;
  if (pc.mode == MODE_STATISTICS || (!touched && !zeros && !penalties)) {
    if (touched && (pc.flags & FLAG_STATISTICS) != 0u) {
      add_statistics(i);
    }
    return;
  }

  const vec3 logScale = vec3(scales[i * 3u], scales[i * 3u + 1u], scales[i * 3u + 2u]);
  const float opacity = 1.0 / (1.0 + exp(-opacities[i]));
  const vec3 s2 = exp(2.0 * logScale);
  // The radii of 3DGS^2-TR: how far each parameter can move before the
  // Gaussian's contribution changes by more than epsilon in squared Hellinger
  // distance. Below 0 for Adam, which rotation always steps by: the paper's
  // bound for it has a constant it never gives.
  const bool secondOrder = (pc.flags & FLAG_SECOND_ORDER) != 0u;
  const float alpha = max(opacity, 1e-3), e = pc.trustRegion;
  const float positionRadius = secondOrder ? sqrt(8.0 * (s2.x + s2.y + s2.z) / 3.0 * e / alpha) : -1.0;
  const float scaleRadius = secondOrder ? sqrt(2.0 * e / alpha) : -1.0; // The parameter is the log of the scale
  const float opacityRadius = secondOrder ? sqrt(4.0 * alpha * e) / max(alpha * (1.0 - alpha), 1e-3) : -1.0; // The logit
  const uint base = i * cam.counts.z, stored = pc.shFloats / 3u;
  vec3 shRadius = vec3(-1.0);
  if (secondOrder) {
    const vec3 colour = clamp(0.5 + SH_C0 * sh_coefficient(base, 0u), 0.02, 1.0);
    shRadius = sqrt(4.0 * colour * e / alpha) / SH_C0;
  }

  if (!touched) {
    // Nothing from the pixels, but the penalties still apply.
    const float o = penalties ? pc.opacityReg * opacity * (1.0 - opacity) : 0.0;
    for (uint a = 0u; a < 3u; ++a) {
      emit_position(i * 3u + a, 0.0, pc.rates[0], positionRadius);
      emit_scale(i * 3u + a, penalties ? pc.scaleReg * exp(logScale[a]) : 0.0, pc.rates[1], scaleRadius);
    }
    if (pc.mode != MODE_CURVATURE) {
      for (uint a = 0u; a < 4u; ++a) {
        emit_rotation(i * 4u + a, 0.0, pc.rates[2], -1.0);
      }
    }
    emit_opacity(i, o, pc.rates[3], opacityRadius);
    for (uint j = 0u; j < pc.shFloats; ++j) {
      store_sh(i, j, 0.0);
    }
    return;
  }
  if ((pc.flags & FLAG_STATISTICS) != 0u) {
    add_statistics(i);
  }

  const vec3 p = vec3(positions[i * 3u], positions[i * 3u + 1u], positions[i * 3u + 2u]);
  vec4 quat = vec4(rotations[i * 4u], rotations[i * 4u + 1u], rotations[i * 4u + 2u], rotations[i * 4u + 3u]);
  const float quatLength = length(quat);
  quat = quatLength > 0.0 ? quat / quatLength : vec4(1.0, 0.0, 0.0, 0.0);

  const uint at = i * RAW_PER_SPLAT;
  const vec3 t = (cam.view * vec4(p, 1.0)).xyz;
  const float fx = cam.intrinsics.x, fy = cam.intrinsics.y;
  const float z = t.z, iz = 1.0 / z, iz2 = iz * iz;

  // Screen-space sums: dL/dcentre and dL/dcovariance as a symmetric matrix.
  const vec2 gCentre = vec2(raw[at + 1u], raw[at + 2u]);

  mat2 G = mat2(raw[at + 3u], raw[at + 4u], raw[at + 4u], raw[at + 5u]);
  float k2 = 1.0; // The 2D Mip filter's opacity factor

  const mat3 Rv = mat3(cam.view);
  const mat3 R = train_quat_to_mat(quat);
  const mat3 D = mat3(s2.x, 0.0, 0.0, 0.0, s2.y, 0.0, 0.0, 0.0, s2.z);
  const float smooth3d = filter3d[i];
  const mat3 sigma = R * D * transpose(R) + mat3(smooth3d);
  const mat3 X = Rv * sigma * transpose(Rv);
  // The 3D filter's opacity factor, k3 = prod sqrt(s2 / (s2 + f)), and what the 2D stage saw.
  const float k3 = sqrt(s2.x / (s2.x + smooth3d) * s2.y / (s2.y + smooth3d) * s2.z / (s2.z + smooth3d));
  const float opacity3 = opacity * k3;

  const float limX = 1.3 * cam.viewport.z, limY = 1.3 * cam.viewport.w;
  const float rx = t.x * iz, ry = t.y * iz;
  const bool clampedX = abs(rx) > limX, clampedY = abs(ry) > limY;
  const float tx = clamp(rx, -limX, limX) * z, ty = clamp(ry, -limY, limY) * z;
  const mat3x2 J = mat3x2(vec2(fx * iz, 0.0), vec2(0.0, fy * iz), vec2(-fx * tx * iz2, -fy * ty * iz2));

  if (pc.mipFilter != 0u) {
    // The filter scales the opacity by k = sqrt(det C / det(C + 0.1 I)) with C
    // the 2D covariance before dilation: that also moves the covariance gradient.
    const mat2 C = J * X * transpose(J);
    const mat2 F = C + mat2(0.1);
    const float detC = determinant(C), detF = determinant(F);
    if (detC > 0.0 && detF > 0.0) {
      const float k = sqrt(detC / detF);
      const mat2 cofC = mat2(C[1][1], -C[0][1], -C[1][0], C[0][0]), cofF = mat2(F[1][1], -F[0][1], -F[1][0], F[0][0]);
      G += raw[at] * opacity3 * 0.5 * k * (cofC / detC - cofF / detF);
      k2 = k;
    } else {
      k2 = 0.0;
    }
  }

  // Position moves the centre, and also how the covariance projects.
  const mat3x2 Jc = mat3x2(vec2(fx * iz, 0.0), vec2(0.0, fy * iz), vec2(-fx * t.x * iz2, -fy * t.y * iz2));
  vec3 gT = transpose(Jc) * gCentre;
  const mat3x2 dJx = mat3x2(vec2(0.0), vec2(0.0), vec2(clampedX ? 0.0 : -fx * iz2, 0.0));
  const mat3x2 dJy = mat3x2(vec2(0.0), vec2(0.0), vec2(0.0, clampedY ? 0.0 : -fy * iz2));
  const mat3x2 dJz = mat3x2(vec2(-fx * iz2, 0.0), vec2(0.0, -fy * iz2),
                            vec2(clampedX ? fx * tx * iz2 * iz : 2.0 * fx * tx * iz2 * iz,
                                 clampedY ? fy * ty * iz2 * iz : 2.0 * fy * ty * iz2 * iz));
  gT += 2.0 * vec3(trace_term(G, dJx, X, J), trace_term(G, dJy, X, J), trace_term(G, dJz, X, J));
  vec3 gP = transpose(Rv) * gT;

  // The 3D covariance: dL = tr(G3 dSigma).
  const mat3x2 T = J * Rv;
  const mat3 G3 = transpose(T) * G * T;
  vec3 gScale;
  for (int a = 0; a < 3; ++a) {
    const vec3 axis = R[a];
    // Plus the filter's opacity factor moving with the scale, and the penalty.
    gScale[a] = 2.0 * s2[a] * dot(axis, G3 * axis) + raw[at] * k2 * opacity * k3 * smooth3d / (s2[a] + smooth3d) + pc.scaleReg * exp(logScale[a]);
  }

  // Rotation: dL = tr(P^T dR). The matrices are dR/dw, dR/dx, dR/dy, dR/dz of
  // the rotation formula, written by columns.
  const mat3 P = 2.0 * G3 * R * D;
  const float w = quat.x, x = quat.y, y = quat.z, zq = quat.w;
  const mat3 dRw = mat3(0.0, 2.0 * zq, -2.0 * y, -2.0 * zq, 0.0, 2.0 * x, 2.0 * y, -2.0 * x, 0.0);
  const mat3 dRx = mat3(0.0, 2.0 * y, 2.0 * zq, 2.0 * y, -4.0 * x, 2.0 * w, 2.0 * zq, -2.0 * w, -4.0 * x);
  const mat3 dRy = mat3(-4.0 * y, 2.0 * x, -2.0 * w, 2.0 * x, 0.0, 2.0 * zq, 2.0 * w, 2.0 * zq, -4.0 * y);
  const mat3 dRz = mat3(-4.0 * zq, 2.0 * w, 2.0 * x, -2.0 * w, -4.0 * zq, 2.0 * y, 2.0 * x, 2.0 * y, 0.0);
  const vec4 gq = vec4(dot(P[0], dRw[0]) + dot(P[1], dRw[1]) + dot(P[2], dRw[2]),
                       dot(P[0], dRx[0]) + dot(P[1], dRx[1]) + dot(P[2], dRx[2]),
                       dot(P[0], dRy[0]) + dot(P[1], dRy[1]) + dot(P[2], dRy[2]),
                       dot(P[0], dRz[0]) + dot(P[1], dRz[1]) + dot(P[2], dRz[2]));
  // The quaternion is normalised before use, so only its tangent part counts.
  const vec4 tangent = (gq - quat * dot(quat, gq)) / max(quatLength, 1e-12);

  const float gOpacity = (raw[at] * k2 * k3 + pc.opacityReg) * opacity * (1.0 - opacity);

  const vec3 gColour = vec3(raw[at + 6u], raw[at + 7u], raw[at + 8u]);
  float basis[16];
  sh_basis(normalize(p - cam.position.xyz), cam.counts.y, basis);
  const uint coefficients = train_sh_coefficients(i, cam.counts.w, pc.shDropout, pc.shRetained, pc.shSeed);
  vec3 colour = vec3(0.5);
  for (uint k = 0u; k < coefficients; ++k) {
    colour += basis[k] * sh_coefficient(base, k);
  }
  // Colour is clamped at zero, where the coefficients stop mattering.
  const vec3 unclamped = vec3(greaterThan(colour, vec3(0.0)));

  // Position also changes the view direction, and with it the colour.
  if (cam.counts.y > 0u) {
    const vec3 toSplat = p - cam.position.xyz;
    const float distance = length(toSplat);
    const vec3 dir = toSplat / distance;
    vec3 basisGradient[16];
    sh_basis_gradient(dir, cam.counts.y, basisGradient);
    vec3 gDir = vec3(0.0);
    for (uint k = 1u; k < coefficients; ++k) {
      const vec3 coefficient = sh_coefficient(base, k);
      gDir += dot(gColour * unclamped, coefficient) * basisGradient[k];
    }
    gP += (gDir - dir * dot(dir, gDir)) / distance;
  }
  if ((pc.flags & FLAG_POSE) != 0u && gP != vec3(0.0)) {
    poseV = Rv * gP;
    poseW = cross(t, poseV);
  }

  // Everything above read the values and the sums before any of them changes.
  for (uint a = 0u; a < 3u; ++a) {
    emit_position(i * 3u + a, gP[a], pc.rates[0], positionRadius);
    emit_scale(i * 3u + a, gScale[a], pc.rates[1], scaleRadius);
  }
  if (pc.mode != MODE_CURVATURE) {
    for (uint a = 0u; a < 4u; ++a) {
      emit_rotation(i * 4u + a, tangent[a], pc.rates[2], -1.0);
    }
  }
  emit_opacity(i, gOpacity, pc.rates[3], opacityRadius);
  if (pc.mode == MODE_GRADIENTS) {
    for (uint k = 0u; k < stored; ++k) {
      const vec3 g = k < coefficients ? basis[k] * gColour * unclamped : vec3(0.0);
      for (uint c = 0u; c < 3u; ++c) {
        store_sh(i, k * 3u + c, g[c]);
      }
    }
  } else {
    // For the SH pass: the gradient of coefficient k is basis[k] times this
    // colour gradient, for the coefficients in use, with the step's radii. A
    // splat nothing reached keeps its sums of zero, so no coefficients.
    const vec3 dir = normalize(p - cam.position.xyz);
    raw[at] = gColour.r * unclamped.r;
    raw[at + 1u] = gColour.g * unclamped.g;
    raw[at + 2u] = gColour.b * unclamped.b;
    raw[at + 3u] = dir.x;
    raw[at + 4u] = dir.y;
    raw[at + 5u] = dir.z;
    raw[at + 6u] = shRadius.r;
    raw[at + 7u] = shRadius.g;
    raw[at + 8u] = shRadius.b;
    raw[at + 9u] = uintBitsToFloat(coefficients);
  }
}

// When refining poses: how the loss changes with the camera, from how it
// changes with each Gaussian's position. Moving the camera by (rotation w,
// translation v) moves a point t in camera space by w x t + v, so
//   dL/dv = sum dL/dt    dL/dw = sum t x dL/dt
// over each workgroup's Gaussians. It leaves out how the camera's rotation turns
// each Gaussian's shape and view direction, which is much the smaller part.
void main() {
  const uint i = gl_GlobalInvocationID.x;
  vec3 w = vec3(0.0), v = vec3(0.0);
  if (i < cam.counts.x) {
    chain(i, w, v);
  }
  if ((pc.flags & FLAG_POSE) != 0u) {
    for (uint k = 0u; k < 3u; ++k) {
      const float totalW = workgroup_sum(w[k]);
      const float totalV = workgroup_sum(v[k]);
      if (gl_LocalInvocationIndex == 0u) {
        poseTotals[gl_WorkGroupID.x * 6u + k] = totalW;
        poseTotals[gl_WorkGroupID.x * 6u + 3u + k] = totalV;
      }
    }
  }
}
