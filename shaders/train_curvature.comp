#version 460
// Second-order training: adds one estimate of the diagonal of J^T J / (values
// in the image) to its running average. A parameter without a gradient was out
// of view and has no estimate.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Gradients { float gradients[]; };
layout(std430, binding = 1) buffer Curvature { float curvature[]; };

layout(push_constant) uniform Push {
  uint count;
  float beta;
  float perValue; // 1 / values in the image
} pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i < pc.count && gradients[i] != 0.0) {
    curvature[i] = pc.beta * curvature[i] + (1.0 - pc.beta) * gradients[i] * gradients[i] * pc.perValue;
  }
}
