#version 460
// Loss, part 0: the rendered image as this view's camera exposed it, for the
// loss passes to compare with the photo. Each view has its own affine colour
// transform, learned alongside the Gaussians, which takes up differences in
// exposure and white balance between photos so that the Gaussians need not.
// The splat itself stays at the neutral exposure.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Image { vec4 image[]; };
layout(std430, binding = 1) writeonly buffer Exposed { vec4 exposed[]; };

layout(push_constant) uniform Push {
  mat3x4 transform; // Rows: rgb' = transform[i] . (rgb, 1)
  uint pixels;
} pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= pc.pixels) {
    return;
  }
  const vec4 rgb1 = vec4(image[i].rgb, 1.0);
  exposed[i] = vec4(dot(pc.transform[0], rgb1), dot(pc.transform[1], rgb1), dot(pc.transform[2], rgb1), image[i].a);
}
