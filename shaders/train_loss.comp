#version 460
// Loss, part 2: per-pixel adjoint dL/dImage for
//   L = (1 - lambda) mean|image - target| + lambda (1 - mean SSIM)
// with means over pixels and channels.

layout(local_size_x = 16) in;

layout(std430, binding = 0) readonly buffer Image { vec4 image[]; };
layout(std430, binding = 1) readonly buffer Target { uint target[]; };
layout(std430, binding = 2) readonly buffer Fields { vec4 fields[]; };
layout(std430, binding = 3) writeonly buffer Adjoint { vec4 adjoint[]; };
layout(std430, binding = 4) writeonly buffer RowTotals { vec2 rowTotals[]; }; // x: SSIM, y: L1

layout(push_constant) uniform Push { uint width; uint height; float lambda; } pc;

const float WEIGHTS[11] = float[](0.00102838, 0.00759876, 0.03600077, 0.10936069, 0.21300554, 0.26601172,
                                  0.21300554, 0.10936069, 0.03600077, 0.00759876, 0.00102838);

void main() {
  const uint row = gl_GlobalInvocationID.x;
  if (row >= pc.height) {
    return;
  }
  const float perValue = 1.0 / (3.0 * float(pc.width) * float(pc.height));
  float rowSum = 0.0;
  for (uint px = 0u; px < pc.width; ++px) {
    const uint at = row * pc.width + px;
    const vec3 x = image[at].rgb;
    const vec3 y = unpackUnorm4x8(target[at]).rgb;
    const vec3 difference = x - y;
    rowSum += abs(difference.r) + abs(difference.g) + abs(difference.b);

    vec3 result = (1.0 - pc.lambda) * sign(difference);
    if (pc.lambda > 0.0) {
      vec3 p = vec3(0.0), q = vec3(0.0), r = vec3(0.0);
      const int y0 = max(int(row) - 5, 0), y1 = min(int(row) + 5, int(pc.height) - 1);
      const int x0 = max(int(px) - 5, 0), x1 = min(int(px) + 5, int(pc.width) - 1);
      for (int v = y0; v <= y1; ++v) {
        const float wy = WEIGHTS[v - int(row) + 5];
        for (int u = x0; u <= x1; ++u) {
          const float w = wy * WEIGHTS[u - int(px) + 5];
          const uint other = (uint(v) * pc.width + uint(u)) * 3u;
          p += w * fields[other].rgb;
          q += w * fields[other + 1u].rgb;
          r += w * fields[other + 2u].rgb;
        }
      }
      result -= pc.lambda * (p + 2.0 * x * q + y * r);
    }
    adjoint[at] = vec4(result * perValue, 0.0);
  }
  rowTotals[row].y = rowSum;
}
