#version 460
// After densification: builds a per-Gaussian array for the new cloud from the
// old one. Element g takes its values from old element source[g], or zeros
// when source[g] is negative (a new Gaussian starts with fresh optimiser
// state). One thread per float.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Source { int source[]; };
layout(std430, binding = 1) readonly buffer In { float values[]; };
layout(std430, binding = 2) writeonly buffer Out { float result[]; };

layout(push_constant) uniform Push {
  uint count;  // Floats in the new array
  uint stride; // Floats per Gaussian
} pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) {
    return;
  }
  const uint g = i / pc.stride, k = i - g * pc.stride;
  const int from = source[g];
  result[i] = from < 0 ? 0.0 : values[uint(from) * pc.stride + k];
}
