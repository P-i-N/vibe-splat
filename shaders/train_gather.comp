#version 460
// After densification: builds a per-Gaussian array for the new cloud from the
// old one. Element g takes its value from old element source[g], or zero when
// source[g] is negative (a new Gaussian starts with fresh optimiser state).
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Source { int source[]; };
layout(std430, binding = 1) readonly buffer In { uint values[]; };
layout(std430, binding = 2) writeonly buffer Out { uint result[]; };

layout(push_constant) uniform Push {
  uint count;  // Elements in the new array
  uint stride; // Elements per Gaussian
} pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= pc.count) {
    return;
  }
  const uint g = i / pc.stride, k = i - g * pc.stride;
  const int from = source[g];
  result[i] = from < 0 ? 0u : values[uint(from) * pc.stride + k];
}
