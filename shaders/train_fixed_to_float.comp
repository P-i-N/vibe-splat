#version 460
// Converts fixed-point gradient sums to floats in place.
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Gradients { int gradients[]; };

layout(push_constant) uniform Push { uint count; float scale; } pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i < pc.count) {
    gradients[i] = floatBitsToInt(float(gradients[i]) / pc.scale);
  }
}
