#version 460
// Forward pass, step 5: composites each tile's splats back to front. Tiles do
// not share pixels, so tiles can run in parallel without blending hardware,
// which is what makes the result available to the following compute passes.
// Output: rgb, and in a the log of the transmittance through all splats.
#extension GL_GOOGLE_include_directive : require
#include "train_types.glsl"

layout(local_size_x = 16) in;

layout(std430, binding = 0) readonly buffer Splats { TrainSplat splats[]; };
layout(std430, binding = 1) readonly buffer EntryValues { uint entryValues[]; };
layout(std430, binding = 2) readonly buffer Ranges { uvec2 ranges[]; };
layout(std430, binding = 3) buffer Image { vec4 image[]; };

layout(push_constant) uniform Push {
  uint width;
  uint height;
  uint gridW;
  uint tileCount;
  vec4 background;
} pc;

void main() {
  const uint tile = gl_GlobalInvocationID.x;
  if (tile >= pc.tileCount) {
    return;
  }
  const uint tx = tile % pc.gridW, ty = tile / pc.gridW;
  const uint x0 = tx * TILE_SIZE, y0 = ty * TILE_SIZE;
  const uint x1 = min(x0 + TILE_SIZE, pc.width), y1 = min(y0 + TILE_SIZE, pc.height);

  // Working in the buffer itself: a local array this size would live in scratch
  // memory on many GPUs, which is several times slower. Tiles do not share pixels.
  for (uint y = y0; y < y1; ++y) {
    for (uint x = x0; x < x1; ++x) {
      image[y * pc.width + x] = vec4(pc.background.rgb, 0.0);
    }
  }
  const uvec2 range = ranges[tile];
  for (uint e = range.x; e < range.y; ++e) {
    const TrainSplat s = splats[entryValues[e]];
    const uvec4 area = splat_pixels(s, uvec4(x0, y0, x1, y1));
    for (uint y = area.y; y < area.w; ++y) {
      for (uint x = area.x; x < area.z; ++x) {
        vec2 d;
        float power, alpha;
        if (!splat_at(s, x, y, d, power, alpha)) {
          continue;
        }
        const uint at = y * pc.width + x;
        const vec4 current = image[at];
        image[at] = vec4(mix(current.rgb, s.color.rgb, alpha), current.a + log(1.0 - alpha));
      }
    }
  }
}
