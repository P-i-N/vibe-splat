#version 460
// Forward pass, step 5: composites each tile's splats front to back. One
// workgroup per tile and one thread per pixel: the tile's splats are staged
// through shared memory in batches, and every thread blends its own pixel in
// registers, writing it once at the end. Tiles do not share pixels, so tiles
// run in parallel without blending hardware, which is what makes the result
// available to the following compute passes.
//
// The tile lists are sorted back to front, so they are read from the end. A
// pixel stops once its transmittance would fall below 1e-4, and a
// tile once all its pixels have, which skips everything hidden behind opaque
// surfaces. The backward pass starts where each pixel stopped.
// Output: rgb, and in a the log of the transmittance through the splats that
// were blended. In stops, where the pixel stopped: the entries of the tile
// list below this index were left out.
#extension GL_GOOGLE_include_directive : require
#include "train_types.glsl"

layout(local_size_x = 16, local_size_y = 16) in; // TILE_SIZE

layout(std430, binding = 0) readonly buffer Splats { TrainSplat splats[]; };
layout(std430, binding = 1) readonly buffer EntryValues { uint entryValues[]; };
layout(std430, binding = 2) readonly buffer Ranges { uvec2 ranges[]; };
layout(std430, binding = 3) writeonly buffer Image { vec4 image[]; };
layout(std430, binding = 4) writeonly buffer Stops { uint stops[]; };

layout(push_constant) uniform Push {
  uint width;
  uint height;
  uint gridW;
  uint tileCount;
  vec4 background;
} pc;

shared TrainSplat batch[TILE_BATCH];
shared uint doneCount; // Pixels of the tile that have stopped

void main() {
  const uint tile = gl_WorkGroupID.x;
  const uint tx = tile % pc.gridW, ty = tile / pc.gridW;
  const uvec4 tilePixels = uvec4(tx * TILE_SIZE, ty * TILE_SIZE, min(tx * TILE_SIZE + TILE_SIZE, pc.width),
                                 min(ty * TILE_SIZE + TILE_SIZE, pc.height));
  const uint x = tilePixels.x + gl_LocalInvocationID.x, y = tilePixels.y + gl_LocalInvocationID.y;
  const bool inside = x < pc.width && y < pc.height;

  const uvec2 range = ranges[tile];
  vec3 rgb = vec3(0.0);
  float transmittance = 1.0, logTransmittance = 0.0;
  uint stop = range.x;
  bool done = !inside;
  if (gl_LocalInvocationIndex == 0u) {
    doneCount = 0u;
  }
  barrier();
  if (done) {
    atomicAdd(doneCount, 1u);
  }
  for (uint end = range.y; end > range.x;) {
    const uint count = min(TILE_BATCH, end - range.x);
    end -= count;
    barrier();
    // Read by every thread between the same two barriers, so all agree.
    if (doneCount == TILE_BATCH) {
      break;
    }
    if (gl_LocalInvocationIndex < count) {
      batch[gl_LocalInvocationIndex] = splats[entryValues[end + gl_LocalInvocationIndex]];
    }
    barrier();
    if (done) {
      continue;
    }
    for (uint k = count; k-- > 0u;) {
      const TrainSplat s = batch[k];
      const uvec4 area = splat_pixels(s, tilePixels);
      if (x < area.x || x >= area.z || y < area.y || y >= area.w) {
        continue;
      }
      vec2 d;
      float power, alpha;
      if (!splat_at(s, x, y, d, power, alpha)) {
        continue;
      }
      const float logRest = log(1.0 - alpha);
      if (logTransmittance + logRest < LOG_MIN_TRANSMITTANCE) {
        stop = end + k + 1u;
        done = true;
        atomicAdd(doneCount, 1u);
        break;
      }
      rgb += transmittance * alpha * s.colorRadius.rgb;
      transmittance *= 1.0 - alpha;
      logTransmittance += logRest;
    }
  }
  if (inside) {
    image[y * pc.width + x] = vec4(rgb + transmittance * pc.background.rgb, logTransmittance);
    stops[y * pc.width + x] = stop;
  }
}
