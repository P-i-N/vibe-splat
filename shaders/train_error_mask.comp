#version 460
// Loss, part 4 when scoring (FastGS): marks in the adjoint's alpha the pixels
// whose error is above a share of this view's worst. The backward pass counts
// them per Gaussian.
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Adjoint { vec4 adjoint[]; };
layout(std430, binding = 1) readonly buffer ErrorMax { uint errorMax; }; // Over 65535

layout(push_constant) uniform Push {
  uint pixels;
  float share;
} pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i < pc.pixels) {
    adjoint[i].a = errorMax > 0u && adjoint[i].a >= pc.share * float(errorMax) / 65535.0 ? 1.0 : 0.0;
  }
}
